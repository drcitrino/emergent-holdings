---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
	<nav class="site-tabs" aria-label="Site">
		<div class="site-tabs-inner">
			<button type="button" class="site-tab is-active" data-site-tab="home">Home</button>
			<button type="button" class="site-tab" data-site-tab="harnesses">Harnesses</button>
			<button type="button" class="site-tab" data-site-tab="performance">Performance</button>
		</div>
	</nav>

	<section class="panel is-active" data-site-panel="home" id="panel-home">
		<div id="census">
			<canvas id="sand" width="65" height="75" aria-hidden="true"></canvas>
			<div class="readout">
				<div class="row spawn"><span>spawned</span><span class="num" data-spawn>0000</span></div>
				<div class="row retire"><span>retired</span><span class="num" data-retire>0000</span></div>
				<div class="row sum"><span>total</span><span class="num" data-total>0000</span></div>
			</div>
		</div>
		<div id="zoom">ZOOM:—</div>
		<div id="ver">v4.7.1</div>
		<canvas id="c"></canvas>
	</section>

	<section class="panel" data-site-panel="harnesses" id="panel-harnesses" aria-label="Harnesses">
		<div class="panel-placeholder"><p>Harnesses — coming soon</p></div>
	</section>

	<section class="panel" data-site-panel="performance" id="panel-performance" aria-label="Performance">
		<div class="panel-placeholder"><p>Performance — coming soon</p></div>
	</section>

	<script is:inline src="/js/sweep-world.js"></script>
	<script is:inline src="/js/census.js"></script>
	<script is:inline src="/js/emergent-scene.js"></script>
	<script is:inline src="/js/site-tabs.js"></script>
</BaseLayout>
