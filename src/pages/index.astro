---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
	<main id="main">
		<section class="hero">
			<p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span> Private holdings</p>
			<h1>Capital with a long horizon.</h1>
			<p class="hero-lead">
				Emergent Holdings is a private investment and holding company. We partner with
				operators, acquire meaningful stakes, and steward assets with patience, clarity, and
				discipline.
			</p>
			<div class="hero-actions">
				<a class="btn btn-primary" href="#contact">Get in touch</a>
				<a class="btn btn-ghost" href="#approach">Our approach</a>
			</div>
		</section>

		<section class="section" id="approach">
			<div class="section-header">
				<h2>Our approach</h2>
				<p>
					We favor simplicity over noise: aligned incentives, transparent governance, and
					decisions measured in years—not quarters.
				</p>
			</div>
			<div class="grid-3">
				<article class="card">
					<h3>Long-term ownership</h3>
					<p>
						We build and hold with a multi-year view, supporting teams through cycles rather
						than optimizing for exits.
					</p>
				</article>
				<article class="card">
					<h3>Disciplined allocation</h3>
					<p>
						Capital is deployed selectively. We underwrite risk carefully and preserve optionality
						for what matters.
					</p>
				</article>
				<article class="card">
					<h3>Operator partnership</h3>
					<p>
						We work alongside management—strategic when useful, quiet when not—respecting the
						businesses we back.
					</p>
				</article>
			</div>
		</section>

		<section class="section" id="focus">
			<div class="section-header">
				<h2>Areas of focus</h2>
				<p>
					Portfolio composition evolves over time. Representative themes include essential
					services, durable software, and asset-light platforms with strong unit economics.
				</p>
			</div>
			<div class="grid-3">
				<article class="card">
					<h3>Operating companies</h3>
					<p>Majority and minority positions in businesses with defensible economics.</p>
				</article>
				<article class="card">
					<h3>Strategic assets</h3>
					<p>Real assets and special situations where patience and structure create value.</p>
				</article>
				<article class="card">
					<h3>Incubation</h3>
					<p>Early-stage initiatives aligned with our ownership philosophy and network.</p>
				</article>
			</div>
		</section>

		<section class="section" id="contact">
			<div class="section-header">
				<h2>Contact</h2>
				<p>For partnership inquiries, introductions, or press, reach out by email.</p>
			</div>
			<div class="contact-panel">
				<p>We review every message and respond when there is a clear fit.</p>
				<a class="contact-email" href="mailto:hello@emergent.holdings">hello@emergent.holdings</a>
			</div>
		</section>
	</main>
</BaseLayout>
